server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # o app tem upload de mídia; o padrão do Nginx (1m) é baixo demais
    client_max_body_size 25m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Proxy reverso pro backend: o navegador só fala com esta origem (o
    # front), então CORS deixa de ser um problema - quem cruza pro backend
    # é o Nginx, servidor a servidor. BACKEND_URL é o endereço de REDE do
    # backend (não precisa, e não deve, ser público) e é substituído aqui
    # em tempo de execução (ver docker-compose.yml e a imagem oficial do
    # Nginx, que processa arquivos *.template com envsubst antes de subir).
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Rotas do Vue Router (history mode): qualquer caminho desconhecido cai no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html nunca pode ficar em cache do navegador, senão uma
    # atualização de deploy não aparece pro usuário
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Assets com hash no nome (gerados pelo build) podem ser cacheados por muito tempo
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
