# Copie para ".env" e ajuste o valor. O docker-compose.yml lê essa
# variável e o Nginx usa ela, em tempo de execução, para saber pra onde
# encaminhar as chamadas de API (proxy reverso em /api/*).
#
# É um endereço de REDE (servidor fala com servidor) - nunca é exposto
# ao navegador, então NÃO precisa ser uma URL pública.
#
# - Backend rodando no host (fora do Docker), com Docker Desktop:
#     BACKEND_URL=http://host.docker.internal:5000
# - Backend como outro serviço no mesmo docker-compose.yml:
#     BACKEND_URL=http://nome-do-servico:5000
BACKEND_URL=http://host.docker.internal:5000

# Porta do HOST que expõe o container (o Nginx dentro dele sempre escuta
# na 80). Padrão 8080 - defina aqui só se precisar de outra porta neste
# ambiente (ex.: já tem algo usando a 8080 na sua máquina).
FRONTEND_PORT=8080
